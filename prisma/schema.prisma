datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model SchemaMigration {
  name      String   @id
  appliedAt DateTime @default(now()) @map("applied_at") @db.Timestamptz

  @@map("schema_migrations")
}

model Admin {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String   @unique @db.VarChar(100)
  passwordHash String   @map("password_hash")
  role         String   @default("admin") @db.VarChar(50)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("admins")
}

model Staff {
  id                      String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherId               String       @unique @map("teacher_id") @db.VarChar(32)
  fullName                String       @map("full_name")
  subject                 String
  salary                  Decimal?     @db.Decimal(12, 2)
  photoUrl                String?      @map("photo_url")
  fingerprintTemplate     String?      @map("fingerprint_template")
  isEnrolled              Boolean      @default(false) @map("is_enrolled")
  fingerprintEnrolledAt   DateTime?    @map("fingerprint_enrolled_at") @db.Timestamptz
  fingerprintUpdatedAt    DateTime?    @map("fingerprint_updated_at") @db.Timestamptz
  fingerprintDeviceSerial String?      @map("fingerprint_device_serial")
  isActive                Boolean      @default(true) @map("is_active")
  createdAt               DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  attendance              Attendance[]

  @@index([isEnrolled, isActive], name: "staff_enrolled_active_index")
  @@index([isActive], name: "staff_is_active_index")
  @@map("staff")
}

model Attendance {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  staffId        String?   @map("staff_id") @db.Uuid
  staff          Staff?    @relation(fields: [staffId], references: [id])
  attendanceDate DateTime  @map("attendance_date") @db.Date
  checkIn        DateTime? @map("check_in") @db.Timestamptz
  checkOut       DateTime? @map("check_out") @db.Timestamptz
  status         String?   @default("Present") @db.VarChar(20)
  confidence     Decimal?  @db.Decimal(5, 4)
  deviceId       String?   @map("device_id")
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([staffId, attendanceDate], name: "attendance_staff_date_unique")
  @@index([attendanceDate(sort: Desc)], name: "attendance_date_index")
  @@map("attendance")
}
