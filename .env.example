# Configure these values in .env.local for local development.
# Configure the same values in Vercel Project Settings -> Environment Variables.

DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require&channel_binding=require
ADMIN_SESSION_SECRET=your_long_random_secret
FINGERPRINT_PROVIDER=fm220

# FM220U L1 local Windows bridge. Use the same token for `npm run bridge:fm220`
# and the Next.js server. Keep this value private.
FM220_BRIDGE_URL=http://127.0.0.1:43120
FM220_BRIDGE_TOKEN=replace_with_long_random_bridge_token
FM220_BRIDGE_HOST=127.0.0.1
FM220_BRIDGE_PORT=43120
FM220_CAPTURE_TIMEOUT_MS=10000
FM220_DUPLICATE_WINDOW_MS=60000
ATTENDANCE_DUPLICATE_WINDOW_SECONDS=1800

# ACPL RD Service discovery defaults. Windows RD Service commonly listens on
# HTTP 11100-11120. Set FM220_RD_BASE_URL if your ACPL test page shows a fixed URL.
FM220_RD_PROTOCOLS=https,http
FM220_RD_PORTS=11100-11120,11080,11200-11220
FM220_RD_ENV=P
FM220_RD_FTYPE=2
FM220_RD_FORMAT=0
FM220_RD_PID_VERSION=2.0
FM220_RD_POSH=UNKNOWN
FM220_RD_WADH=

# Optional official SDK matcher wrapper. Required when ACPL RD Service returns
# encrypted PID blocks that cannot be locally compared by hash.
# The command must read JSON from stdin and write JSON to stdout.
# FM220_SDK_COMMAND=C:\LittlePlanet\fm220-sdk-match.cmd

# Generate a secure ADMIN_SESSION_SECRET:
# openssl rand -base64 32
